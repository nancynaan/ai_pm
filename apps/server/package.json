{
  "name": "@ai-pm/server",
  "version": "0.1.0",
  "private": true,
  "description": "AI PM pipeline server: harness, agents, Atlassian integration, scheduler and API.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@ai-pm/shared": "^0.1.0",
    "@fastify/static": "^10.1.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
