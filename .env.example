# AI PM pipeline configuration.
# Copy this file to .env and fill it in. .env is git-ignored and never baked into the Docker image.
# An empty value means "not set".

# --- Claude (your Claude subscription, through the Claude Code CLI) ------------
# Docker: run `claude setup-token` on your machine once and paste the token here.
# Running the server directly on your machine: leave empty to use your existing Claude Code login.
CLAUDE_CODE_OAUTH_TOKEN=
# Model every agent uses
CLAUDE_MODEL=claude-opus-5-5
# Only for running on your machine when `claude` is not on PATH,
# e.g. C:\Users\<you>\.local\bin\claude.exe (Docker always uses its own copy)
CLAUDE_CLI_PATH=

# --- Atlassian Cloud ----------------------------------------------------------
# Your site, e.g. https://your-site.atlassian.net
ATLASSIAN_SITE_URL=
# The email you log in to Atlassian with
ATLASSIAN_EMAIL=
# Classic API token ("Create API token", not "with scopes"):
# https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=
# Key of the company-managed Scrum project, e.g. ERG
JIRA_PROJECT_KEY=
# Optional; found automatically from the project when empty
JIRA_BOARD_ID=
# Key of the Confluence space, e.g. ERG
CONFLUENCE_SPACE_KEY=
# dry-run: log Jira/Confluence writes without sending them. live: write for real.
ATLASSIAN_WRITE_MODE=dry-run

# --- Pipeline behaviour -------------------------------------------------------
# true skips the client's Approve / Request changes / Decline step (for fast demos)
CLIENT_GATE_AUTO_APPROVE=false

# --- Database (PostgreSQL container) ------------------------------------------
POSTGRES_USER=aipm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aipm
# Port published on your machine; the app container always uses 5432 inside Docker
POSTGRES_PORT=5432

# --- Email reminders ----------------------------------------------------------
# Leave SMTP_HOST empty to send every email to the local Mailpit inbox (http://localhost:8025).
# For real email, set your provider's host, port (usually 587), user and password.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
NOTIFY_FROM=ai-pm@localhost

# --- App ----------------------------------------------------------------------
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
TZ=America/New_York
