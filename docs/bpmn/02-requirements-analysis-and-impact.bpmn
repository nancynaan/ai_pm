<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_D02" targetNamespace="https://github.com/ai-pm/bpmn" exporter="ai-pm bpmn generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_D02">
    <bpmn:participant id="Participant_D02_ai" name="AI PM Pipeline" processRef="Process_D02_ai" />
    <bpmn:participant id="Participant_D02_atl" name="Atlassian Cloud: Jira &amp; Confluence (REST API)" />
    <bpmn:messageFlow id="Message_D02_1" name="Backlog, GDD, DoD, architecture" sourceRef="Participant_D02_atl" targetRef="h_ctx" />
  </bpmn:collaboration>
  <bpmn:process id="Process_D02_ai" name="AI PM Pipeline" isExecutable="false">
    <bpmn:laneSet id="LaneSet_D02_ai">
      <bpmn:lane id="Lane_D02_h" name="Pipeline engine (deterministic)">
        <bpmn:flowNodeRef>h_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_ctx</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_classify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_core</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_persist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_D02_ra" name="Requirements Analyst Agent">
        <bpmn:flowNodeRef>ra_cat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ra_prio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ra_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ra_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ra_assume</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ra_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_D02_ia" name="Impact &amp; Dependency Agent">
        <bpmn:flowNodeRef>ia_impact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ia_deps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ia_spike</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="h_start" name="Elicited requirements baseline">
      <bpmn:outgoing>Flow_D02_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="h_ctx" name="Fetch context for the agents: backlog (JQL), GDD, DoD, architecture">
      <bpmn:incoming>Flow_D02_1</bpmn:incoming>
      <bpmn:outgoing>Flow_D02_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="ra_cat" name="Categorize: functional vs non-functional (ISO 25010)">
      <bpmn:incoming>Flow_D02_2</bpmn:incoming>
      <bpmn:outgoing>Flow_D02_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ra_prio" name="Prioritize (MoSCoW) and define the MVP slice">
      <bpmn:incoming>Flow_D02_3</bpmn:incoming>
      <bpmn:outgoing>Flow_D02_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ra_conf" name="Detect conflicts &amp; duplicates vs GDD, DoD, backlog">
      <bpmn:incoming>Flow_D02_4</bpmn:incoming>
      <bpmn:outgoing>Flow_D02_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="ra_split">
      <bpmn:incoming>Flow_D02_5</bpmn:incoming>
      <bpmn:outgoing>Flow_D02_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_D02_7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="ra_assume" name="Identify assumptions &amp; constraints (time, budget, platform, compliance)">
      <bpmn:incoming>Flow_D02_6</bpmn:incoming>
      <bpmn:outgoing>Flow_D02_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ia_impact" name="Map impact on game components &amp; performance budget">
      <bpmn:incoming>Flow_D02_7</bpmn:incoming>
      <bpmn:outgoing>Flow_D02_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ia_deps" name="Identify dependencies: components, SDKs, other Epics, skills">
      <bpmn:incoming>Flow_D02_8</bpmn:incoming>
      <bpmn:outgoing>Flow_D02_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="ra_join">
      <bpmn:incoming>Flow_D02_9</bpmn:incoming>
      <bpmn:incoming>Flow_D02_10</bpmn:incoming>
      <bpmn:outgoing>Flow_D02_11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:businessRuleTask id="h_classify" name="Classify change magnitude">
      <bpmn:incoming>Flow_D02_11</bpmn:incoming>
      <bpmn:outgoing>Flow_D02_12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="h_core" name="Core engine affected?">
      <bpmn:incoming>Flow_D02_12</bpmn:incoming>
      <bpmn:outgoing>Flow_D02_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_D02_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="ia_spike" name="Propose technical spike &amp; architecture notes">
      <bpmn:incoming>Flow_D02_13</bpmn:incoming>
      <bpmn:outgoing>Flow_D02_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="h_merge">
      <bpmn:incoming>Flow_D02_14</bpmn:incoming>
      <bpmn:incoming>Flow_D02_15</bpmn:incoming>
      <bpmn:outgoing>Flow_D02_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="h_persist" name="Validate &amp; persist analysis (REQ IDs, relations, impacts)">
      <bpmn:incoming>Flow_D02_16</bpmn:incoming>
      <bpmn:outgoing>Flow_D02_17</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataAssoc_D02_1"><bpmn:targetRef>db</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="h_end" name="Analyzed requirements">
      <bpmn:incoming>Flow_D02_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="db" name="Pipeline DB" />
    <bpmn:sequenceFlow id="Flow_D02_1" sourceRef="h_start" targetRef="h_ctx" />
    <bpmn:sequenceFlow id="Flow_D02_2" sourceRef="h_ctx" targetRef="ra_cat" />
    <bpmn:sequenceFlow id="Flow_D02_3" sourceRef="ra_cat" targetRef="ra_prio" />
    <bpmn:sequenceFlow id="Flow_D02_4" sourceRef="ra_prio" targetRef="ra_conf" />
    <bpmn:sequenceFlow id="Flow_D02_5" sourceRef="ra_conf" targetRef="ra_split" />
    <bpmn:sequenceFlow id="Flow_D02_6" sourceRef="ra_split" targetRef="ra_assume" />
    <bpmn:sequenceFlow id="Flow_D02_7" sourceRef="ra_split" targetRef="ia_impact" />
    <bpmn:sequenceFlow id="Flow_D02_8" sourceRef="ia_impact" targetRef="ia_deps" />
    <bpmn:sequenceFlow id="Flow_D02_9" sourceRef="ra_assume" targetRef="ra_join" />
    <bpmn:sequenceFlow id="Flow_D02_10" sourceRef="ia_deps" targetRef="ra_join" />
    <bpmn:sequenceFlow id="Flow_D02_11" sourceRef="ra_join" targetRef="h_classify" />
    <bpmn:sequenceFlow id="Flow_D02_12" sourceRef="h_classify" targetRef="h_core" />
    <bpmn:sequenceFlow id="Flow_D02_13" name="Yes" sourceRef="h_core" targetRef="ia_spike" />
    <bpmn:sequenceFlow id="Flow_D02_14" name="No" sourceRef="h_core" targetRef="h_merge" />
    <bpmn:sequenceFlow id="Flow_D02_15" sourceRef="ia_spike" targetRef="h_merge" />
    <bpmn:sequenceFlow id="Flow_D02_16" sourceRef="h_merge" targetRef="h_persist" />
    <bpmn:sequenceFlow id="Flow_D02_17" sourceRef="h_persist" targetRef="h_end" />
    <bpmn:textAnnotation id="n_rule"><bpmn:text>UI/cosmetic: new screens, skins, assets only. Feature extension: new mechanics on existing systems. Core engine: physics, movement, netcode, save format or frame budget.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="n_components"><bpmn:text>Component map from the Architecture Overview page (in the prompt): physics, rendering, input, level generator, UI/HUD, economy &amp; store, backend, ads &amp; analytics SDKs</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_D02_1" associationDirection="None" sourceRef="h_classify" targetRef="n_rule" />
    <bpmn:association id="Assoc_D02_2" associationDirection="None" sourceRef="ia_impact" targetRef="n_components" />
  </bpmn:process>
