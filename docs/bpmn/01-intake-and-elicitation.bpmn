<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_D01" targetNamespace="https://github.com/ai-pm/bpmn" exporter="ai-pm bpmn generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_D01">
    <bpmn:participant id="Participant_D01_client" name="Client (feature sponsor)" processRef="Process_D01_client" />
    <bpmn:participant id="Participant_D01_ai" name="AI PM Pipeline" processRef="Process_D01_ai" />
    <bpmn:participant id="Participant_D01_atl" name="Atlassian Cloud: Jira &amp; Confluence (REST API)" />
    <bpmn:messageFlow id="Message_D01_1" name="Feature description" sourceRef="c_describe" targetRef="h_start" />
    <bpmn:messageFlow id="Message_D01_2" name="Create Epic (Draft)" sourceRef="h_epic" targetRef="Participant_D01_atl" />
    <bpmn:messageFlow id="Message_D01_3" name="Questionnaire" sourceRef="h_send" targetRef="c_q" />
    <bpmn:messageFlow id="Message_D01_4" name="Answers + comment" sourceRef="c_answer" targetRef="h_answers" />
    <bpmn:messageFlow id="Message_D01_5" name="Discovery report" sourceRef="h_report" targetRef="Participant_D01_client" />
    <bpmn:messageFlow id="Message_D01_6" name="Preliminary assessment or stop?" sourceRef="h_offer" targetRef="c_offer" />
    <bpmn:messageFlow id="Message_D01_7" name="Decision + comment" sourceRef="c_decide" targetRef="h_decision" />
  </bpmn:collaboration>
  <bpmn:process id="Process_D01_client" name="Client (feature sponsor)" isExecutable="false">
    <bpmn:startEvent id="c_start" name="Feature idea">
      <bpmn:outgoing>Flow_D01_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="c_describe" name="Describe the feature in the chat">
      <bpmn:incoming>Flow_D01_1</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="c_q" name="Questionnaire received">
      <bpmn:incoming>Flow_D01_2</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c_q_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="c_answer" name="Answer: single/multi choice, &quot;Not yet determined&quot;, comment">
      <bpmn:incoming>Flow_D01_3</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="c_end" name="Answers submitted">
      <bpmn:incoming>Flow_D01_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="c_offer" name="Preliminary assessment offered">
      <bpmn:outgoing>Flow_D01_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c_offer_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="c_decide" name="Decide: preliminary assessment or stop">
      <bpmn:incoming>Flow_D01_5</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="c_decided" name="Decision sent">
      <bpmn:incoming>Flow_D01_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_D01_1" sourceRef="c_start" targetRef="c_describe" />
    <bpmn:sequenceFlow id="Flow_D01_2" sourceRef="c_describe" targetRef="c_q" />
    <bpmn:sequenceFlow id="Flow_D01_3" sourceRef="c_q" targetRef="c_answer" />
    <bpmn:sequenceFlow id="Flow_D01_4" sourceRef="c_answer" targetRef="c_end" />
    <bpmn:sequenceFlow id="Flow_D01_5" sourceRef="c_offer" targetRef="c_decide" />
    <bpmn:sequenceFlow id="Flow_D01_6" sourceRef="c_decide" targetRef="c_decided" />
  </bpmn:process>
  <bpmn:process id="Process_D01_ai" name="AI PM Pipeline" isExecutable="false">
    <bpmn:laneSet id="LaneSet_D01_ai">
      <bpmn:lane id="Lane_D01_h" name="Pipeline engine (orchestrator, deterministic)">
        <bpmn:flowNodeRef>h_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_epic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_answers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_persist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_rules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_continue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_preliminary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_stopped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_D01_ag" name="Elicitation Agent (Claude + skills)">
        <bpmn:flowNodeRef>g_understand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_questions</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_D01_rv" name="Discovery Review Agent (Claude + skills)">
        <bpmn:flowNodeRef>v_review</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="h_start" name="Feature description received">
      <bpmn:outgoing>Flow_D01_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="h_start_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="h_register" name="Register the request, open a pipeline run, load the baseline digest">
      <bpmn:incoming>Flow_D01_7</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_8</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataAssoc_D01_1"><bpmn:targetRef>db1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:task id="g_understand" name="Restate the idea; list candidate requirements &amp; feature gaps">
      <bpmn:incoming>Flow_D01_8</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="g_questions" name="Add at most 2 feature-specific questions the core set does not cover">
      <bpmn:incoming>Flow_D01_9</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="h_epic" name="Create draft Epic in Jira on the PO's behalf">
      <bpmn:incoming>Flow_D01_10</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="h_build" name="Build questionnaire: 10 fixed questions + feature questions + comment">
      <bpmn:incoming>Flow_D01_11</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="h_merge">
      <bpmn:incoming>Flow_D01_12</bpmn:incoming>
      <bpmn:incoming>Flow_D01_23</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="h_send" name="Send questionnaire to the client chat">
      <bpmn:incoming>Flow_D01_13</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="h_answers" name="Answers received">
      <bpmn:incoming>Flow_D01_14</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="h_answers_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="h_persist" name="Validate &amp; persist answers (limits, exclusive options, details)">
      <bpmn:incoming>Flow_D01_15</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataAssoc_D01_2"><bpmn:targetRef>db2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="h_rules" name="Completeness rules: coverage, contradictions, gaps, evidence, approval">
      <bpmn:incoming>Flow_D01_16</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_17</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:task id="v_review" name="Review what rules cannot see; findings by kind, assumptions">
      <bpmn:incoming>Flow_D01_17</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="h_report" name="Discovery Completeness Report; open points to the Assumption Log">
      <bpmn:incoming>Flow_D01_18</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="h_result" name="Result?">
      <bpmn:incoming>Flow_D01_19</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_D01_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_D01_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="h_complete" name="Discovery verified: go to analysis">
      <bpmn:incoming>Flow_D01_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="h_clarify" name="Prepare clarification questions (at most 4, predefined answers)">
      <bpmn:incoming>Flow_D01_21</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="h_offer" name="Offer a preliminary assessment or stop">
      <bpmn:incoming>Flow_D01_22</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="h_decision" name="Client decision received">
      <bpmn:incoming>Flow_D01_24</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_25</bpmn:outgoing>
      <bpmn:messageEventDefinition id="h_decision_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="h_record" name="Record the client's decision">
      <bpmn:incoming>Flow_D01_25</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="h_continue" name="Continue?">
      <bpmn:incoming>Flow_D01_26</bpmn:incoming>
      <bpmn:outgoing>Flow_D01_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_D01_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="h_preliminary" name="Preliminary discovery: go to analysis">
      <bpmn:incoming>Flow_D01_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="h_stopped" name="Stopped by the client: run declined">
      <bpmn:incoming>Flow_D01_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="db1" name="Pipeline DB (PostgreSQL)" />
    <bpmn:dataStoreReference id="db2" name="Pipeline DB" />
    <bpmn:sequenceFlow id="Flow_D01_7" sourceRef="h_start" targetRef="h_register" />
    <bpmn:sequenceFlow id="Flow_D01_8" sourceRef="h_register" targetRef="g_understand" />
    <bpmn:sequenceFlow id="Flow_D01_9" sourceRef="g_understand" targetRef="g_questions" />
    <bpmn:sequenceFlow id="Flow_D01_10" sourceRef="g_questions" targetRef="h_epic" />
    <bpmn:sequenceFlow id="Flow_D01_11" sourceRef="h_epic" targetRef="h_build" />
    <bpmn:sequenceFlow id="Flow_D01_12" sourceRef="h_build" targetRef="h_merge" />
    <bpmn:sequenceFlow id="Flow_D01_13" sourceRef="h_merge" targetRef="h_send" />
    <bpmn:sequenceFlow id="Flow_D01_14" sourceRef="h_send" targetRef="h_answers" />
    <bpmn:sequenceFlow id="Flow_D01_15" sourceRef="h_answers" targetRef="h_persist" />
    <bpmn:sequenceFlow id="Flow_D01_16" sourceRef="h_persist" targetRef="h_rules" />
    <bpmn:sequenceFlow id="Flow_D01_17" sourceRef="h_rules" targetRef="v_review" />
    <bpmn:sequenceFlow id="Flow_D01_18" sourceRef="v_review" targetRef="h_report" />
    <bpmn:sequenceFlow id="Flow_D01_19" sourceRef="h_report" targetRef="h_result" />
    <bpmn:sequenceFlow id="Flow_D01_20" name="Complete" sourceRef="h_result" targetRef="h_complete" />
    <bpmn:sequenceFlow id="Flow_D01_21" name="Needs clarification" sourceRef="h_result" targetRef="h_clarify" />
    <bpmn:sequenceFlow id="Flow_D01_22" name="Insufficient" sourceRef="h_result" targetRef="h_offer" />
    <bpmn:sequenceFlow id="Flow_D01_23" sourceRef="h_clarify" targetRef="h_merge" />
    <bpmn:sequenceFlow id="Flow_D01_24" sourceRef="h_offer" targetRef="h_decision" />
    <bpmn:sequenceFlow id="Flow_D01_25" sourceRef="h_decision" targetRef="h_record" />
    <bpmn:sequenceFlow id="Flow_D01_26" sourceRef="h_record" targetRef="h_continue" />
    <bpmn:sequenceFlow id="Flow_D01_27" name="Yes: preliminary assessment" sourceRef="h_continue" targetRef="h_preliminary" />
    <bpmn:sequenceFlow id="Flow_D01_28" name="No: stop" sourceRef="h_continue" targetRef="h_stopped" />
    <bpmn:textAnnotation id="n_core"><bpmn:text>Core questionnaire (config/discovery.yaml): 10 fixed questions in five areas: business justification, product context, scope, feasibility, decision readiness. Single or multi choice with limits, exclusive options (&quot;Not yet determined&quot;), detail fields. Never asks for effort, cost or uplift.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="n_feature"><bpmn:text>Only topics the core questions miss; never technical estimates.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="n_review"><bpmn:text>Adds only what rules cannot see: description vs. answers, comments, feature answers. Labels each finding confirmed, client assumption, AI hypothesis or missing.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="n_result"><bpmn:text>Complete (or with assumptions: open points recorded, results preliminary) → analysis. Needs clarification: blocking contradiction or critical gap, round &lt; 2. Insufficient: still blocked after the last round.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_D01_1" associationDirection="None" sourceRef="h_build" targetRef="n_core" />
    <bpmn:association id="Assoc_D01_2" associationDirection="None" sourceRef="g_questions" targetRef="n_feature" />
    <bpmn:association id="Assoc_D01_3" associationDirection="None" sourceRef="v_review" targetRef="n_review" />
    <bpmn:association id="Assoc_D01_4" associationDirection="None" sourceRef="h_report" targetRef="n_result" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_D01" name="01 Intake &amp; elicitation">
    <bpmndi:BPMNPlane id="Plane_D01" bpmnElement="Collaboration_D01">
      <bpmndi:BPMNShape id="Participant_D01_client_di" bpmnElement="Participant_D01_client" isHorizontal="true"><dc:Bounds x="40" y="40" width="3520" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_D01_ai_di" bpmnElement="Participant_D01_ai" isHorizontal="true"><dc:Bounds x="40" y="336" width="3520" height="864" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_D01_h_di" bpmnElement="Lane_D01_h" isHorizontal="true"><dc:Bounds x="70" y="336" width="3490" height="384" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_D01_ag_di" bpmnElement="Lane_D01_ag" isHorizontal="true"><dc:Bounds x="70" y="720" width="3490" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_D01_rv_di" bpmnElement="Lane_D01_rv" isHorizontal="true"><dc:Bounds x="70" y="960" width="3490" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_D01_atl_di" bpmnElement="Participant_D01_atl" isHorizontal="true"><dc:Bounds x="40" y="1256" width="3520" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_start_di" bpmnElement="c_start"><dc:Bounds x="187" y="82" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="166" y="122" width="79" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_describe_di" bpmnElement="c_describe"><dc:Bounds x="310" y="60" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_q_di" bpmnElement="c_q"><dc:Bounds x="1547" y="82" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1520" y="50" width="90" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_answer_di" bpmnElement="c_answer"><dc:Bounds x="1670" y="60" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_end_di" bpmnElement="c_end"><dc:Bounds x="1887" y="82" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1860" y="122" width="90" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_offer_di" bpmnElement="c_offer"><dc:Bounds x="2737" y="202" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2710" y="156" width="90" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_decide_di" bpmnElement="c_decide"><dc:Bounds x="2860" y="180" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_decided_di" bpmnElement="c_decided"><dc:Bounds x="3077" y="202" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="3053" y="242" width="85" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_start_di" bpmnElement="h_start"><dc:Bounds x="357" y="498" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="330" y="538" width="90" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_register_di" bpmnElement="h_register"><dc:Bounds x="480" y="476" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_understand_di" bpmnElement="g_understand"><dc:Bounds x="650" y="740" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_questions_di" bpmnElement="g_questions"><dc:Bounds x="820" y="740" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_epic_di" bpmnElement="h_epic"><dc:Bounds x="990" y="476" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_build_di" bpmnElement="h_build"><dc:Bounds x="1160" y="476" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_merge_di" bpmnElement="h_merge" isMarkerVisible="true"><dc:Bounds x="1370" y="491" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_send_di" bpmnElement="h_send"><dc:Bounds x="1500" y="476" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_answers_di" bpmnElement="h_answers"><dc:Bounds x="1717" y="498" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1690" y="538" width="90" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_persist_di" bpmnElement="h_persist"><dc:Bounds x="1840" y="476" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_rules_di" bpmnElement="h_rules"><dc:Bounds x="2010" y="476" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="v_review_di" bpmnElement="v_review"><dc:Bounds x="2180" y="980" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_report_di" bpmnElement="h_report"><dc:Bounds x="2350" y="476" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_result_di" bpmnElement="h_result" isMarkerVisible="true"><dc:Bounds x="2560" y="491" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="2516" y="479" width="48" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_complete_di" bpmnElement="h_complete"><dc:Bounds x="2737" y="498" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2710" y="538" width="90" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_clarify_di" bpmnElement="h_clarify"><dc:Bounds x="2690" y="596" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_offer_di" bpmnElement="h_offer"><dc:Bounds x="2690" y="356" width="130" height="80" /></bpmndi:BPMNShape>
