      <bpmndi:BPMNEdge id="Flow_D05_4_di" bpmnElement="Flow_D05_4"><di:waypoint x="1250" y="100" /><di:waypoint x="1670" y="100" /><bpmndi:BPMNLabel><dc:Bounds x="1258" y="82" width="17" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_D05_5_di" bpmnElement="Flow_D05_5"><di:waypoint x="1290" y="220" /><di:waypoint x="1480" y="220" /><di:waypoint x="1480" y="100" /><di:waypoint x="1670" y="100" /></bpmndi:BPMNEdge>
