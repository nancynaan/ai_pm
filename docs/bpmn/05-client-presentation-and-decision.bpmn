<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_D05" targetNamespace="https://github.com/ai-pm/bpmn" exporter="ai-pm bpmn generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_D05">
    <bpmn:participant id="Participant_D05_client" name="Client (feature sponsor)" processRef="Process_D05_client" />
    <bpmn:participant id="Participant_D05_ai" name="AI PM Pipeline" processRef="Process_D05_ai" />
    <bpmn:participant id="Participant_D05_atl" name="Atlassian Cloud: Jira &amp; Confluence (REST API)" />
    <bpmn:messageFlow id="Message_D05_1" name="Slides + summary" sourceRef="h_present" targetRef="c_start" />
    <bpmn:messageFlow id="Message_D05_2" name="Publish to Confluence" sourceRef="c_pub" targetRef="h_pub" />
    <bpmn:messageFlow id="Message_D05_3" name="PPTX attachment, Brief update" sourceRef="h_attach" targetRef="Participant_D05_atl" />
    <bpmn:messageFlow id="Message_D05_4" name="Decision + comment" sourceRef="c_decide" targetRef="h_decision" />
    <bpmn:messageFlow id="Message_D05_5" name="Decision on Brief &amp; log; Epic closed" sourceRef="h_decline" targetRef="Participant_D05_atl" />
    <bpmn:messageFlow id="Message_D05_6" name="Generate and publish first" sourceRef="h_block" targetRef="c_fix" />
  </bpmn:collaboration>
  <bpmn:process id="Process_D05_client" name="Client (feature sponsor)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_D05_client">
      <bpmn:lane id="Lane_D05_client" name="Client (feature sponsor)">
        <bpmn:flowNodeRef>c_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_pub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_fix</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c_start" name="Proposal received">
      <bpmn:outgoing>Flow_D05_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c_start_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="c_review" name="Review the three slides">
      <bpmn:incoming>Flow_D05_1</bpmn:incoming>
      <bpmn:outgoing>Flow_D05_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="c_gw" name="Publish the deck?">
      <bpmn:incoming>Flow_D05_2</bpmn:incoming>
      <bpmn:outgoing>Flow_D05_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_D05_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="c_pub" name="Optional: &quot;Publish to Confluence&quot; (documents published; once)">
      <bpmn:incoming>Flow_D05_3</bpmn:incoming>
      <bpmn:outgoing>Flow_D05_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="c_decide" name="Decide: Approve / Decline">
      <bpmn:incoming>Flow_D05_4</bpmn:incoming>
      <bpmn:incoming>Flow_D05_5</bpmn:incoming>
      <bpmn:incoming>Flow_D05_7</bpmn:incoming>
      <bpmn:outgoing>Flow_D05_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="c_end" name="Decision sent">
      <bpmn:incoming>Flow_D05_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="c_fix" name="Generate and publish the documents (Documents card), then approve again">
      <bpmn:outgoing>Flow_D05_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_D05_1" sourceRef="c_start" targetRef="c_review" />
    <bpmn:sequenceFlow id="Flow_D05_2" sourceRef="c_review" targetRef="c_gw" />
    <bpmn:sequenceFlow id="Flow_D05_3" name="Yes" sourceRef="c_gw" targetRef="c_pub" />
    <bpmn:sequenceFlow id="Flow_D05_4" name="No" sourceRef="c_gw" targetRef="c_decide" />
    <bpmn:sequenceFlow id="Flow_D05_5" sourceRef="c_pub" targetRef="c_decide" />
    <bpmn:sequenceFlow id="Flow_D05_6" sourceRef="c_decide" targetRef="c_end" />
    <bpmn:sequenceFlow id="Flow_D05_7" sourceRef="c_fix" targetRef="c_decide" />
  </bpmn:process>
  <bpmn:process id="Process_D05_ai" name="AI PM Pipeline" isExecutable="false">
    <bpmn:laneSet id="LaneSet_D05_ai">
      <bpmn:lane id="Lane_D05_h" name="Pipeline engine (deterministic)">
        <bpmn:flowNodeRef>h_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_render</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_present</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_pub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_attach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_pubend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_block</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_declined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_D05_pr" name="Presenter Agent">
        <bpmn:flowNodeRef>pr_insights</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pr_story</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="h_start" name="Documents generated or skipped">
      <bpmn:outgoing>Flow_D05_8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="pr_insights" name="Pick the message: opportunity, solution, feasibility">
      <bpmn:incoming>Flow_D05_8</bpmn:incoming>
      <bpmn:outgoing>Flow_D05_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="pr_story" name="Word the three slides (one call)">
      <bpmn:incoming>Flow_D05_9</bpmn:incoming>
      <bpmn:outgoing>Flow_D05_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="h_render" name="Fill in figures &amp; KPI chart; render slides; PPTX download">
      <bpmn:incoming>Flow_D05_10</bpmn:incoming>
      <bpmn:outgoing>Flow_D05_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="h_present" name="Proposal card, question, decision buttons in the chat">
      <bpmn:incoming>Flow_D05_11</bpmn:incoming>
      <bpmn:outgoing>Flow_D05_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="h_pub" name="Client publishes the deck">
      <bpmn:outgoing>Flow_D05_21</bpmn:outgoing>
      <bpmn:messageEventDefinition id="h_pub_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="h_attach" name="Attach the PPTX to the Feature Brief; re-render the Brief to embed it">
      <bpmn:incoming>Flow_D05_21</bpmn:incoming>
      <bpmn:outgoing>Flow_D05_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="h_pubend" name="Deck published: the button reads &quot;Published&quot;">
      <bpmn:incoming>Flow_D05_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="h_decision" name="Decision received">
      <bpmn:incoming>Flow_D05_12</bpmn:incoming>
      <bpmn:incoming>Flow_D05_18</bpmn:incoming>
      <bpmn:outgoing>Flow_D05_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="h_decision_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="h_gw" name="Decision?">
      <bpmn:incoming>Flow_D05_13</bpmn:incoming>
      <bpmn:outgoing>Flow_D05_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_D05_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="h_docs" name="Documents published?">
      <bpmn:incoming>Flow_D05_14</bpmn:incoming>
      <bpmn:outgoing>Flow_D05_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_D05_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="h_block" name="Approve locked: ask to generate and publish the documents">
      <bpmn:incoming>Flow_D05_17</bpmn:incoming>
      <bpmn:outgoing>Flow_D05_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="h_log" name="Save the approval in the DB">
      <bpmn:incoming>Flow_D05_16</bpmn:incoming>
      <bpmn:outgoing>Flow_D05_19</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataAssoc_D05_1"><bpmn:targetRef>db</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="h_approved" name="Approved: start backlog generation">
      <bpmn:incoming>Flow_D05_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="h_decline" name="Save the decline; record it on the Brief &amp; Assumption Log (if published); close the draft Epic">
      <bpmn:incoming>Flow_D05_15</bpmn:incoming>
      <bpmn:outgoing>Flow_D05_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="h_declined" name="Declined: chat closed, Backlog red">
      <bpmn:incoming>Flow_D05_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="db" name="Pipeline DB" />
    <bpmn:sequenceFlow id="Flow_D05_8" sourceRef="h_start" targetRef="pr_insights" />
    <bpmn:sequenceFlow id="Flow_D05_9" sourceRef="pr_insights" targetRef="pr_story" />
    <bpmn:sequenceFlow id="Flow_D05_10" sourceRef="pr_story" targetRef="h_render" />
    <bpmn:sequenceFlow id="Flow_D05_11" sourceRef="h_render" targetRef="h_present" />
    <bpmn:sequenceFlow id="Flow_D05_12" sourceRef="h_present" targetRef="h_decision" />
    <bpmn:sequenceFlow id="Flow_D05_13" sourceRef="h_decision" targetRef="h_gw" />
    <bpmn:sequenceFlow id="Flow_D05_14" name="Approve" sourceRef="h_gw" targetRef="h_docs" />
    <bpmn:sequenceFlow id="Flow_D05_15" name="Decline" sourceRef="h_gw" targetRef="h_decline" />
    <bpmn:sequenceFlow id="Flow_D05_16" name="Yes" sourceRef="h_docs" targetRef="h_log" />
    <bpmn:sequenceFlow id="Flow_D05_17" name="No" sourceRef="h_docs" targetRef="h_block" />
    <bpmn:sequenceFlow id="Flow_D05_18" sourceRef="h_block" targetRef="h_decision" />
    <bpmn:sequenceFlow id="Flow_D05_19" sourceRef="h_log" targetRef="h_approved" />
    <bpmn:sequenceFlow id="Flow_D05_20" sourceRef="h_decline" targetRef="h_declined" />
    <bpmn:sequenceFlow id="Flow_D05_21" sourceRef="h_pub" targetRef="h_attach" />
    <bpmn:sequenceFlow id="Flow_D05_22" sourceRef="h_attach" targetRef="h_pubend" />
    <bpmn:textAnnotation id="n_slides"><bpmn:text>Three slides: 1 Business opportunity (objective, target KPI, impact range, audience, value; KPI impact chart). 2 Proposed solution &amp; scope (player flow, four capabilities, counts, one scope boundary). 3 Delivery feasibility &amp; recommendation (date range, budget range, major risks, key dependencies, suggested verdict). No story points; every slide says preliminary, not a commitment.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="n_deck"><bpmn:text>Optional and once: greyed out until the documents are published, then green, then &quot;Published&quot; with the Confluence link. The decision does not wait for it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_D05_1" associationDirection="None" sourceRef="pr_story" targetRef="n_slides" />
    <bpmn:association id="Assoc_D05_2" associationDirection="None" sourceRef="h_attach" targetRef="n_deck" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_D05" name="05 Presentation &amp; decision">
    <bpmndi:BPMNPlane id="Plane_D05" bpmnElement="Collaboration_D05">
      <bpmndi:BPMNShape id="Participant_D05_client_di" bpmnElement="Participant_D05_client" isHorizontal="true"><dc:Bounds x="40" y="40" width="2670" height="240" /></bpmndi:BPMNShape>
