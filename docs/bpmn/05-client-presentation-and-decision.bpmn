      <bpmndi:BPMNEdge id="Flow_D05_7_di" bpmnElement="Flow_D05_7"><di:waypoint x="2245" y="180" /><di:waypoint x="2245" y="40" /><di:waypoint x="1735" y="40" /><di:waypoint x="1735" y="60" /></bpmndi:BPMNEdge>
