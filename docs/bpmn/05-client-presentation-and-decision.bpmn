      <bpmndi:BPMNEdge id="Flow_D05_10_di" bpmnElement="Flow_D05_10"><di:waypoint x="610" y="756" /><di:waypoint x="630" y="756" /><di:waypoint x="630" y="516" /><di:waypoint x="650" y="516" /></bpmndi:BPMNEdge>
