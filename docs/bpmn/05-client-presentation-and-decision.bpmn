      <bpmndi:BPMNShape id="db_di" bpmnElement="db"><dc:Bounds x="2475" y="491" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="2464" y="545" width="73" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
