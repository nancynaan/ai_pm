      <bpmndi:BPMNShape id="db_di" bpmnElement="db"><dc:Bounds x="2050" y="327" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="2039" y="381" width="73" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
