<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_D03" targetNamespace="https://github.com/ai-pm/bpmn" exporter="ai-pm bpmn generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_D03">
    <bpmn:participant id="Participant_D03_atl" name="Atlassian Cloud: Jira &amp; Confluence (REST API)" />
    <bpmn:participant id="Participant_D03_ai" name="AI PM Pipeline" processRef="Process_D03_ai" />
    <bpmn:messageFlow id="Message_D03_1" name="Closed sprints (velocity)" sourceRef="Participant_D03_atl" targetRef="h_vel" />
  </bpmn:collaboration>
  <bpmn:process id="Process_D03_ai" name="AI PM Pipeline" isExecutable="false">
    <bpmn:laneSet id="LaneSet_D03_ai">
      <bpmn:lane id="Lane_D03_h" name="Pipeline engine (deterministic calculators)">
        <bpmn:flowNodeRef>h_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_vel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_mc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_roi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_verdict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_persist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_D03_es" name="Estimator Agent">
        <bpmn:flowNodeRef>es_map</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>es_size</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_D03_rk" name="Risk Analyst Agent">
        <bpmn:flowNodeRef>rk_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rk_identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rk_assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rk_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_D03_va" name="Value Analyst Agent">
        <bpmn:flowNodeRef>va_value</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="h_start" name="Analyzed requirements">
      <bpmn:outgoing>Flow_D03_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="rk_split">
      <bpmn:incoming>Flow_D03_1</bpmn:incoming>
      <bpmn:outgoing>Flow_D03_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_D03_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_D03_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="es_map" name="Draft story map: candidate stories &amp; spikes">
      <bpmn:incoming>Flow_D03_2</bpmn:incoming>
      <bpmn:outgoing>Flow_D03_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="es_size" name="Relative sizing + three-point estimates (O / M / P)">
      <bpmn:incoming>Flow_D03_5</bpmn:incoming>
      <bpmn:outgoing>Flow_D03_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="h_vel" name="Fetch velocity history &amp; team capacity">
      <bpmn:incoming>Flow_D03_6</bpmn:incoming>
      <bpmn:outgoing>Flow_D03_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="h_mc" name="PERT roll-up + Monte Carlo release forecast">
      <bpmn:incoming>Flow_D03_7</bpmn:incoming>
      <bpmn:outgoing>Flow_D03_8</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:task id="rk_identify" name="Identify risks (cause, event, effect)">
      <bpmn:incoming>Flow_D03_3</bpmn:incoming>
      <bpmn:outgoing>Flow_D03_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="rk_assess" name="Score probability × impact; responses, owners, triggers">
      <bpmn:incoming>Flow_D03_9</bpmn:incoming>
      <bpmn:outgoing>Flow_D03_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="va_value" name="Estimate value drivers in 3 scenarios (retention, ARPDAU, ads)">
      <bpmn:incoming>Flow_D03_4</bpmn:incoming>
      <bpmn:outgoing>Flow_D03_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="rk_join">
      <bpmn:incoming>Flow_D03_8</bpmn:incoming>
      <bpmn:incoming>Flow_D03_10</bpmn:incoming>
      <bpmn:incoming>Flow_D03_11</bpmn:incoming>
      <bpmn:outgoing>Flow_D03_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:scriptTask id="h_budget" name="Resources &amp; budget: roles × sprints × rates + EMV contingency">
      <bpmn:incoming>Flow_D03_12</bpmn:incoming>
      <bpmn:outgoing>Flow_D03_13</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="h_roi" name="ROI, NPV, payback &amp; WSJF">
      <bpmn:incoming>Flow_D03_13</bpmn:incoming>
      <bpmn:outgoing>Flow_D03_14</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="h_verdict" name="Feasibility verdict">
      <bpmn:incoming>Flow_D03_14</bpmn:incoming>
      <bpmn:outgoing>Flow_D03_15</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="h_persist" name="Persist estimates, forecast, budget, risks, value">
      <bpmn:incoming>Flow_D03_15</bpmn:incoming>
      <bpmn:outgoing>Flow_D03_16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataAssoc_D03_1"><bpmn:targetRef>db</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="h_end" name="Assessment data ready">
      <bpmn:incoming>Flow_D03_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="db" name="Pipeline DB" />
    <bpmn:sequenceFlow id="Flow_D03_1" sourceRef="h_start" targetRef="rk_split" />
    <bpmn:sequenceFlow id="Flow_D03_2" sourceRef="rk_split" targetRef="es_map" />
    <bpmn:sequenceFlow id="Flow_D03_3" sourceRef="rk_split" targetRef="rk_identify" />
    <bpmn:sequenceFlow id="Flow_D03_4" sourceRef="rk_split" targetRef="va_value" />
    <bpmn:sequenceFlow id="Flow_D03_5" sourceRef="es_map" targetRef="es_size" />
    <bpmn:sequenceFlow id="Flow_D03_6" sourceRef="es_size" targetRef="h_vel" />
    <bpmn:sequenceFlow id="Flow_D03_7" sourceRef="h_vel" targetRef="h_mc" />
    <bpmn:sequenceFlow id="Flow_D03_8" sourceRef="h_mc" targetRef="rk_join" />
    <bpmn:sequenceFlow id="Flow_D03_9" sourceRef="rk_identify" targetRef="rk_assess" />
    <bpmn:sequenceFlow id="Flow_D03_10" sourceRef="rk_assess" targetRef="rk_join" />
    <bpmn:sequenceFlow id="Flow_D03_11" sourceRef="va_value" targetRef="rk_join" />
    <bpmn:sequenceFlow id="Flow_D03_12" sourceRef="rk_join" targetRef="h_budget" />
    <bpmn:sequenceFlow id="Flow_D03_13" sourceRef="h_budget" targetRef="h_roi" />
    <bpmn:sequenceFlow id="Flow_D03_14" sourceRef="h_roi" targetRef="h_verdict" />
    <bpmn:sequenceFlow id="Flow_D03_15" sourceRef="h_verdict" targetRef="h_persist" />
    <bpmn:sequenceFlow id="Flow_D03_16" sourceRef="h_persist" targetRef="h_end" />
    <bpmn:textAnnotation id="n_mc"><bpmn:text>PERT E = (O + 4M + P) / 6. Monte Carlo, 10,000 runs, velocity resampled from past sprints, capacity share for this Epic.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="n_roi"><bpmn:text>Inputs: KPI baseline from the Business Case (DAU, ARPDAU, retention) and the Value Analyst's KPI effects per scenario, within benchmark ranges (not the client's hopes; no evidence → no effect in the pessimistic case). WSJF = cost of delay / job size.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="n_rule"><bpmn:text>No-Go if any of: (1) even the MVP misses a hard deadline, at P85 and at P50; (2) the P85 cost is more than 1.25 × the budget limit (the client's limit, else the remaining approved budget); (3) a critical risk (score ≥ 20) is accepted without mitigation; (4) even the optimistic value case does not cover the cost. Thresholds: config/feasibility-rules.yaml.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_D03_1" associationDirection="None" sourceRef="h_mc" targetRef="n_mc" />
    <bpmn:association id="Assoc_D03_2" associationDirection="None" sourceRef="h_roi" targetRef="n_roi" />
    <bpmn:association id="Assoc_D03_3" associationDirection="None" sourceRef="h_verdict" targetRef="n_rule" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_D03" name="03 Estimation, value &amp; risk">
    <bpmndi:BPMNPlane id="Plane_D03" bpmnElement="Collaboration_D03">
      <bpmndi:BPMNShape id="Participant_D03_atl_di" bpmnElement="Participant_D03_atl" isHorizontal="true"><dc:Bounds x="40" y="40" width="2330" height="60" /></bpmndi:BPMNShape>
