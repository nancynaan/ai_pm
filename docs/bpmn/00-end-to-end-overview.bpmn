<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_D00" targetNamespace="https://github.com/ai-pm/bpmn" exporter="ai-pm bpmn generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_D00">
    <bpmn:participant id="Participant_D00_client" name="Client (feature sponsor)" processRef="Process_D00_client" />
    <bpmn:participant id="Participant_D00_org" name="Delivery organization" processRef="Process_D00_org" />
    <bpmn:participant id="Participant_D00_atl" name="Atlassian Cloud: Jira &amp; Confluence (REST API)" />
    <bpmn:messageFlow id="Message_D00_1" name="Feature description" sourceRef="c_describe" targetRef="a_start" />
    <bpmn:messageFlow id="Message_D00_2" name="Questionnaire" sourceRef="a_intake" targetRef="c_answer" />
    <bpmn:messageFlow id="Message_D00_3" name="Answers" sourceRef="c_answer" targetRef="a_intake" />
    <bpmn:messageFlow id="Message_D00_4" name="Assessment &amp; slides" sourceRef="a_present" targetRef="c_receive" />
    <bpmn:messageFlow id="Message_D00_5" name="Decision" sourceRef="c_decide" targetRef="a_decision" />
    <bpmn:messageFlow id="Message_D00_6" name="Draft Epic" sourceRef="a_intake" targetRef="Participant_D00_atl" />
    <bpmn:messageFlow id="Message_D00_7" name="Baseline &amp; backlog" sourceRef="Participant_D00_atl" targetRef="a_analysis" />
    <bpmn:messageFlow id="Message_D00_8" name="Confluence pages (optional)" sourceRef="a_docs" targetRef="Participant_D00_atl" />
    <bpmn:messageFlow id="Message_D00_9" name="Epic, stories, links" sourceRef="a_backlog" targetRef="Participant_D00_atl" />
    <bpmn:messageFlow id="Message_D00_10" name="Review in Jira" sourceRef="po_review" targetRef="Participant_D00_atl" />
    <bpmn:messageFlow id="Message_D00_11" name="Sub-tasks, estimates" sourceRef="t_refine" targetRef="Participant_D00_atl" />
  </bpmn:collaboration>
  <bpmn:process id="Process_D00_client" name="Client (feature sponsor)" isExecutable="false">
    <bpmn:startEvent id="c_start" name="New feature idea">
      <bpmn:outgoing>Flow_D00_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="c_describe" name="Describe the feature in the chat UI">
      <bpmn:incoming>Flow_D00_1</bpmn:incoming>
      <bpmn:outgoing>Flow_D00_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="c_answer" name="Answer questionnaire (predefined options)">
      <bpmn:incoming>Flow_D00_2</bpmn:incoming>
      <bpmn:outgoing>Flow_D00_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="c_receive" name="Assessment &amp; slides received">
      <bpmn:incoming>Flow_D00_3</bpmn:incoming>
      <bpmn:outgoing>Flow_D00_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c_receive_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="c_decide" name="Review presentation and decide">
      <bpmn:incoming>Flow_D00_4</bpmn:incoming>
      <bpmn:outgoing>Flow_D00_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="c_end" name="Decision sent">
      <bpmn:incoming>Flow_D00_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_D00_1" sourceRef="c_start" targetRef="c_describe" />
    <bpmn:sequenceFlow id="Flow_D00_2" sourceRef="c_describe" targetRef="c_answer" />
    <bpmn:sequenceFlow id="Flow_D00_3" sourceRef="c_answer" targetRef="c_receive" />
    <bpmn:sequenceFlow id="Flow_D00_4" sourceRef="c_receive" targetRef="c_decide" />
    <bpmn:sequenceFlow id="Flow_D00_5" sourceRef="c_decide" targetRef="c_end" />
  </bpmn:process>
  <bpmn:process id="Process_D00_org" name="Delivery organization" isExecutable="false">
    <bpmn:laneSet id="LaneSet_D00_org">
      <bpmn:lane id="Lane_D00_ai" name="AI PM Pipeline (automated)">
        <bpmn:flowNodeRef>a_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_intake</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_analysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_estimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_present</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_backlog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_declined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_D00_po" name="Product Owner">
        <bpmn:flowNodeRef>po_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>po_order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_D00_team" name="Scrum Team">
        <bpmn:flowNodeRef>t_refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ready</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="a_start" name="Feature request received">
      <bpmn:outgoing>Flow_D00_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a_start_def" />
    </bpmn:startEvent>
    <bpmn:callActivity id="a_intake" name="Intake &amp; elicitation" calledElement="Process_D01_ai">
      <bpmn:incoming>Flow_D00_6</bpmn:incoming>
      <bpmn:outgoing>Flow_D00_7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="a_analysis" name="Analysis &amp; impact" calledElement="Process_D02_ai">
      <bpmn:incoming>Flow_D00_7</bpmn:incoming>
      <bpmn:outgoing>Flow_D00_8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="a_estimate" name="Estimation, value &amp; risk" calledElement="Process_D03_ai">
      <bpmn:incoming>Flow_D00_8</bpmn:incoming>
      <bpmn:outgoing>Flow_D00_9</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="a_docs" name="Documents: generate (or skip); publish optional" calledElement="Process_D04_ai">
      <bpmn:incoming>Flow_D00_9</bpmn:incoming>
      <bpmn:outgoing>Flow_D00_10</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="a_present" name="Client presentation" calledElement="Process_D05_ai">
      <bpmn:incoming>Flow_D00_10</bpmn:incoming>
      <bpmn:outgoing>Flow_D00_11</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:intermediateCatchEvent id="a_decision" name="Client decision received">
      <bpmn:incoming>Flow_D00_11</bpmn:incoming>
      <bpmn:outgoing>Flow_D00_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a_decision_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="a_gw" name="Decision?">
      <bpmn:incoming>Flow_D00_12</bpmn:incoming>
      <bpmn:outgoing>Flow_D00_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_D00_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="a_backlog" name="Backlog generation (Jira)" calledElement="Process_D06_org">
      <bpmn:incoming>Flow_D00_13</bpmn:incoming>
      <bpmn:outgoing>Flow_D00_15</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="a_declined" name="Feature declined: chat closed">
      <bpmn:incoming>Flow_D00_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="po_review" name="Review &amp; adjust Epic and stories in Jira">
      <bpmn:incoming>Flow_D00_15</bpmn:incoming>
      <bpmn:outgoing>Flow_D00_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="po_order" name="Order the Product Backlog">
      <bpmn:incoming>Flow_D00_16</bpmn:incoming>
      <bpmn:outgoing>Flow_D00_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="t_refine" name="Backlog Refinement: clarify, split, add sub-tasks, estimate">
      <bpmn:incoming>Flow_D00_17</bpmn:incoming>
      <bpmn:outgoing>Flow_D00_18</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="t_ready" name="Stories Ready for Sprint Planning">
      <bpmn:incoming>Flow_D00_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_D00_6" sourceRef="a_start" targetRef="a_intake" />
    <bpmn:sequenceFlow id="Flow_D00_7" sourceRef="a_intake" targetRef="a_analysis" />
    <bpmn:sequenceFlow id="Flow_D00_8" sourceRef="a_analysis" targetRef="a_estimate" />
    <bpmn:sequenceFlow id="Flow_D00_9" sourceRef="a_estimate" targetRef="a_docs" />
    <bpmn:sequenceFlow id="Flow_D00_10" sourceRef="a_docs" targetRef="a_present" />
    <bpmn:sequenceFlow id="Flow_D00_11" sourceRef="a_present" targetRef="a_decision" />
    <bpmn:sequenceFlow id="Flow_D00_12" sourceRef="a_decision" targetRef="a_gw" />
    <bpmn:sequenceFlow id="Flow_D00_13" name="Approve" sourceRef="a_gw" targetRef="a_backlog" />
    <bpmn:sequenceFlow id="Flow_D00_14" name="Decline" sourceRef="a_gw" targetRef="a_declined" />
    <bpmn:sequenceFlow id="Flow_D00_15" sourceRef="a_backlog" targetRef="po_review" />
    <bpmn:sequenceFlow id="Flow_D00_16" sourceRef="po_review" targetRef="po_order" />
    <bpmn:sequenceFlow id="Flow_D00_17" sourceRef="po_order" targetRef="t_refine" />
    <bpmn:sequenceFlow id="Flow_D00_18" sourceRef="t_refine" targetRef="t_ready" />
    <bpmn:textAnnotation id="n_epic"><bpmn:text>Draft Epic is created on the PO's behalf at intake and completed at backlog generation</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="n_manual"><bpmn:text>Human Scrum event: not automated. The pipeline only prepares the input.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="n_optional"><bpmn:text>Documents can be skipped for any verdict and published once, at any time; the flow never waits for a publish. Approve needs the documents published; the deck stays optional.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_D00_1" associationDirection="None" sourceRef="a_intake" targetRef="n_epic" />
    <bpmn:association id="Assoc_D00_2" associationDirection="None" sourceRef="t_refine" targetRef="n_manual" />
    <bpmn:association id="Assoc_D00_3" associationDirection="None" sourceRef="a_docs" targetRef="n_optional" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_D00" name="00 Overview">
    <bpmndi:BPMNPlane id="Plane_D00" bpmnElement="Collaboration_D00">
