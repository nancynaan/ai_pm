<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_D06" targetNamespace="https://github.com/ai-pm/bpmn" exporter="ai-pm bpmn generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_D06">
    <bpmn:participant id="Participant_D06_atl" name="Atlassian Cloud: Jira &amp; Confluence (REST API)" />
    <bpmn:participant id="Participant_D06_org" name="Delivery organization" processRef="Process_D06_org" />
    <bpmn:messageFlow id="Message_D06_1" name="Epic" sourceRef="h_epic" targetRef="Participant_D06_atl" />
    <bpmn:messageFlow id="Message_D06_2" name="Stories" sourceRef="h_create" targetRef="Participant_D06_atl" />
    <bpmn:messageFlow id="Message_D06_3" name="Issue links" sourceRef="h_links" targetRef="Participant_D06_atl" />
    <bpmn:messageFlow id="Message_D06_4" name="Confluence pages" sourceRef="h_conf" targetRef="Participant_D06_atl" />
    <bpmn:messageFlow id="Message_D06_5" name="Review in Jira" sourceRef="po_review" targetRef="Participant_D06_atl" />
    <bpmn:messageFlow id="Message_D06_6" name="Sub-tasks" sourceRef="t_refine" targetRef="Participant_D06_atl" />
    <bpmn:messageFlow id="Message_D06_7" name="Story points" sourceRef="t_estimate" targetRef="Participant_D06_atl" />
  </bpmn:collaboration>
  <bpmn:process id="Process_D06_org" name="Delivery organization" isExecutable="false">
    <bpmn:laneSet id="LaneSet_D06_org">
      <bpmn:lane id="Lane_D06_h" name="AI PM: Pipeline engine">
        <bpmn:flowNodeRef>h_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_cov</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_epic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_links</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_keys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_card</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_D06_bb" name="AI PM: Backlog Builder Agent">
        <bpmn:flowNodeRef>bb_write</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_D06_po" name="Product Owner">
        <bpmn:flowNodeRef>po_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>po_order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_D06_team" name="Scrum Team (Developers)">
        <bpmn:flowNodeRef>t_refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_estimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="h_start" name="Client approved the feature (documents published)">
      <bpmn:outgoing>Flow_D06_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="h_cov" name="Coverage gate: every requirement (except Won't) has a story">
      <bpmn:incoming>Flow_D06_1</bpmn:incoming>
      <bpmn:outgoing>Flow_D06_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="bb_write" name="Write the Epic text and one story per item: Connextra, Gherkin AC, blockers (one call)">
      <bpmn:incoming>Flow_D06_2</bpmn:incoming>
      <bpmn:incoming>Flow_D06_5</bpmn:incoming>
      <bpmn:outgoing>Flow_D06_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="h_gate" name="DoR gate: one story per item, Connextra, blockers without cycles, no sizes">
      <bpmn:incoming>Flow_D06_3</bpmn:incoming>
      <bpmn:outgoing>Flow_D06_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="h_ok" name="Gate passed?">
      <bpmn:incoming>Flow_D06_4</bpmn:incoming>
      <bpmn:outgoing>Flow_D06_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_D06_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="h_plan" name="Proposed priority, AI estimate (PERT), labels ai-draft &amp; fa-&lt;n&gt;">
      <bpmn:incoming>Flow_D06_6</bpmn:incoming>
      <bpmn:outgoing>Flow_D06_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="h_epic" name="Create or complete the Epic; link the Feature Brief">
      <bpmn:incoming>Flow_D06_7</bpmn:incoming>
      <bpmn:outgoing>Flow_D06_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="h_create" name="Create or update the stories under the Epic">
      <bpmn:incoming>Flow_D06_8</bpmn:incoming>
      <bpmn:outgoing>Flow_D06_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="h_links" name="Create &quot;Blocks&quot; links">
      <bpmn:incoming>Flow_D06_9</bpmn:incoming>
      <bpmn:outgoing>Flow_D06_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="h_conf" name="Initial Product Backlog block; re-render the Feature Brief (if published)">
      <bpmn:incoming>Flow_D06_10</bpmn:incoming>
      <bpmn:outgoing>Flow_D06_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="h_keys" name="Store the Jira keys in the DB">
      <bpmn:incoming>Flow_D06_11</bpmn:incoming>
      <bpmn:outgoing>Flow_D06_12</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataAssoc_D06_1"><bpmn:targetRef>db</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="h_card" name="Backlog card with the Epic link; chat closed; Backlog tab">
      <bpmn:incoming>Flow_D06_12</bpmn:incoming>
      <bpmn:outgoing>Flow_D06_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="po_review" name="Review &amp; adjust the AI draft in Jira; remove ai-draft">
      <bpmn:incoming>Flow_D06_13</bpmn:incoming>
      <bpmn:outgoing>Flow_D06_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="po_order" name="Order the Product Backlog; mark &quot;Ready for refinement&quot;">
      <bpmn:incoming>Flow_D06_14</bpmn:incoming>
      <bpmn:outgoing>Flow_D06_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="t_refine" name="Backlog Refinement: clarify, split, add sub-tasks">
      <bpmn:incoming>Flow_D06_15</bpmn:incoming>
      <bpmn:outgoing>Flow_D06_16</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="t_estimate" name="Estimate (Planning Poker) &amp; confirm DoR">
      <bpmn:incoming>Flow_D06_16</bpmn:incoming>
      <bpmn:outgoing>Flow_D06_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="t_end" name="Stories Ready for Sprint Planning">
      <bpmn:incoming>Flow_D06_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="db" name="Pipeline DB" />
    <bpmn:sequenceFlow id="Flow_D06_1" sourceRef="h_start" targetRef="h_cov" />
    <bpmn:sequenceFlow id="Flow_D06_2" sourceRef="h_cov" targetRef="bb_write" />
    <bpmn:sequenceFlow id="Flow_D06_3" sourceRef="bb_write" targetRef="h_gate" />
    <bpmn:sequenceFlow id="Flow_D06_4" sourceRef="h_gate" targetRef="h_ok" />
    <bpmn:sequenceFlow id="Flow_D06_5" name="No: repair (at most 2)" sourceRef="h_ok" targetRef="bb_write" />
    <bpmn:sequenceFlow id="Flow_D06_6" name="Yes" sourceRef="h_ok" targetRef="h_plan" />
    <bpmn:sequenceFlow id="Flow_D06_7" sourceRef="h_plan" targetRef="h_epic" />
    <bpmn:sequenceFlow id="Flow_D06_8" sourceRef="h_epic" targetRef="h_create" />
    <bpmn:sequenceFlow id="Flow_D06_9" sourceRef="h_create" targetRef="h_links" />
    <bpmn:sequenceFlow id="Flow_D06_10" sourceRef="h_links" targetRef="h_conf" />
    <bpmn:sequenceFlow id="Flow_D06_11" sourceRef="h_conf" targetRef="h_keys" />
    <bpmn:sequenceFlow id="Flow_D06_12" sourceRef="h_keys" targetRef="h_card" />
    <bpmn:sequenceFlow id="Flow_D06_13" sourceRef="h_card" targetRef="po_review" />
    <bpmn:sequenceFlow id="Flow_D06_14" sourceRef="po_review" targetRef="po_order" />
    <bpmn:sequenceFlow id="Flow_D06_15" sourceRef="po_order" targetRef="t_refine" />
    <bpmn:sequenceFlow id="Flow_D06_16" sourceRef="t_refine" targetRef="t_estimate" />
    <bpmn:sequenceFlow id="Flow_D06_17" sourceRef="t_estimate" targetRef="t_end" />
    <bpmn:textAnnotation id="n_jira"><bpmn:text>Every issue: status To Do, no sprint, label ai-draft (plus ai-pm, fa-&lt;n&gt;, and enabler, nfr or spike), proposed priority &quot;pending PO review&quot;, AI-generated description with Gherkin AC, custom field &quot;AI estimate (SP)&quot;. Story Points stay empty for the team. Found again by sync log and marker label: no duplicates.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="n_manual"><bpmn:text>Human Scrum event: not automated. The pipeline only prepares the input.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_D06_1" associationDirection="None" sourceRef="h_create" targetRef="n_jira" />
    <bpmn:association id="Assoc_D06_2" associationDirection="None" sourceRef="t_refine" targetRef="n_manual" />
  </bpmn:process>
