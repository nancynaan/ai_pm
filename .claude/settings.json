{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx tsc *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(npx drizzle-kit *)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose exec *)",
      "Bash(docker compose build*)",
      "Bash(docker compose up *)",
      "Bash(docker compose stop*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "PowerShell(npm run *)",
      "PowerShell(npm test*)",
      "PowerShell(npx tsc *)",
      "PowerShell(npx prettier *)",
      "PowerShell(npx eslint *)",
      "PowerShell(npx vitest *)",
      "PowerShell(docker compose ps*)",
      "PowerShell(docker compose logs*)",
      "PowerShell(docker compose exec *)",
      "PowerShell(docker compose build*)",
      "PowerShell(docker compose up *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "PowerShell(git commit*)",
      "PowerShell(git push*)",
      "Bash(*--live*)",
      "PowerShell(*--live*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./package-lock.json)",
      "Read(./apps/server/drizzle/meta/**)",
      "Edit(./apps/server/drizzle/meta/**)",
      "Read(./**/dist/**)",
      "Read(./**/node_modules/**)",
      "Read(./coverage/**)",
      "Bash(git push --force*)",
      "Bash(docker compose down -v*)",
      "PowerShell(git push --force*)",
      "PowerShell(docker compose down -v*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check.mjs\"",
            "timeout": 240,
            "statusMessage": "Quality gate: typecheck, lint, tests"
          }
        ]
      }
    ]
  }
}
